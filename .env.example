APP_ENV=development
DEMO_MODE=false
GOOGLE_MAPS_API_KEY=
DATABASE_URL=postgresql+psycopg://relief:change-me@localhost:5432/relief_rl
MODEL_PATH=rl/checkpoints/best_model.pt
QRDQN_MODEL_PATH=rl/checkpoints/qrdqn_best_model.pt
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ALERT_DISTANCE_HIGH_M=500
ALERT_DISTANCE_MODERATE_M=1500
ALERT_COOLDOWN_S=60

# Admin authentication — replace before deployment
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Local PostGIS compose
POSTGRES_PASSWORD=change-me

# Hugging Face explanation layer (Section 18) — optional, explanation-only.
# Never controls PPO/QR-DQN/routes/vehicles/rewards. When HF_ENABLED=false or
# the token/call fails, the backend falls back to the existing rule-based
# explanation and reports SOURCE: RULE-BASED FALLBACK.
HF_ENABLED=false
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-3B-Instruct
HF_TIMEOUT_SECONDS=12
HF_MAX_NEW_TOKENS=400
